# Quantum28 — environment (copy to .env; never commit real secrets)
# Personal-use market data only. Do not display/redistribute; never send raw feed to free models.

# ---- Data feed selection (datafeed.py) --------------------------------------
DATAFEED_PRIMARY=tastytrade        # tastytrade | ibkr | demo
DATAFEED_FALLBACK=ibkr             # used automatically if primary is unavailable/errors
# (demo is always the last-resort fallback so the pipeline runs with no creds)

# ---- Tastytrade (primary: streaming greeks + chains via dxfeed) --------------
# OAuth personal grant — create at my.tastytrade.com -> Manage -> API Access -> OAuth
# Applications: make an app (grab the client SECRET), then "New Personal OAuth Grant"
# (grab the REFRESH TOKEN). Headless-friendly: the SDK auto-refreshes, so 2FA never prompts.
TASTY_CLIENT_SECRET=               # the OAuth application's client secret (shown once)
TASTY_REFRESH_TOKEN=               # the personal grant's refresh token (never expires)
TASTY_IS_TEST=0                    # 1 = sandbox/cert environment (simulated data)
# TASTY_ACCOUNT=                   # optional, if you scope to one account
# Streaming knobs (optional): how wide a strike window to pull, and how long to wait for events.
TASTY_STREAM_TIMEOUT=8             # seconds to wait for greeks/summary before giving up
GEX_STRIKE_WIDTH_PCT=0.10          # pull strikes within ±this fraction of spot for the GEX read
# TASTY_SPOT_SPX=                  # optional spot override if the index quote is slow to arrive
# Market-data entitlement: real-time greeks need your non-professional/pro subscription active.

# ---- Interactive Brokers (fallback: TWS / IB Gateway must be running) --------
IB_ENABLED=0                       # set 1 to enable the ibkr backend
IB_HOST=127.0.0.1
IB_PORT=7497                       # 7497 paper TWS / 7496 live / 4002 gateway paper / 4001 live
IB_CLIENT_ID=17
# Mind the market-data "lines" cap when scanning a full chain for GEX.

# ---- GEX algorithm (optional) -----------------------------------------------
# Drop your algorithm in gex_algo.py:  def compute_gex(chain, **kw) -> gamma block.
# If absent, datafeed.py uses a labeled placeholder.

# ---- Human-in-the-loop: Telegram --------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Dashboard bridge (server.py) -------------------------------------------
QUANTUM_API_TOKEN=                 # bearer token the dashboard must send; leave blank = no auth
QUANTUM_API_HOST=127.0.0.1
QUANTUM_API_PORT=8787

# ---- Models (the judgment analysts — Claude via llm.py) ---------------------
# The LLM voters call Claude per the routing in config.yaml (Sonnet/Haiku; Opus off-schedule).
# LEAVE ANTHROPIC_API_KEY BLANK to run mock-first: analysts return neutral schema-valid stubs and
# the whole pipeline runs offline at $0. Set the key to go live. Q28_LLM_MOCK=1 forces mock even
# with a key set (useful for testing). Free/cheap endpoints receive ONLY public data.
ANTHROPIC_API_KEY=                 # from console.anthropic.com — blank = mock mode ($0)
# Q28_LLM_MOCK=0                   # set 1 to force neutral stubs even when a key is present
MODEL_PRIMARY=
MODEL_PRIMARY_API_KEY=
MODEL_CHEAP=
MODEL_CHEAP_API_KEY=

# ---- Macro / fundamentals / events (all free keys) --------------------------
FRED_API_KEY=                      # St. Louis Fed macro series (STLFSI4, HY OAS, WALCL, …)
EIA_API_KEY=                       # EIA nat-gas storage (Thu 10:30) + crude inventory (Wed 10:30)
NOAA_TOKEN=                        # NOAA CPC 6-15 day HDD/CDD (nat-gas weather)
FINNHUB_API_KEY=                   # earnings calendar / IPO calendar / company news (free tier 60/min)
FMP_API_KEY=                       # fundamentals ratios + earnings (optional, paid tiers)

# ---- Tuning knobs (change on Railway -> Deploy; no code edit) ----------------
MIN_CONVICTION=0.60                # dead-band: |vote_net| below this = no directional trade.
#   Raise toward 0.70 on noisy days to cut trade count; lower for more candidates.
# ORCH_ALLOWED_CALLERS=demo-pm,pm-desk,scheduler   # who may invoke the pipeline

# ---- Single-stock futures go-live (Basis Trader) ----------------------------
SSF_GO_LIVE=2026-09-15             # basis.py MONITORS but emits no order tickets before this date
